# ============================================================================
# Environment template — NEVER commit real values.
# Copy to `.env.local` and fill in values from your Supabase project dashboard
# (Project Settings → API) and OpenRouter (https://openrouter.ai/keys).
# ============================================================================

# Supabase project (free tier). Publishable key is public — it is safe in the client.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY

# Service role key — SECRET. Server-side ONLY (scripts/seed-users.mjs).
# NEVER ship this to the browser. Regenerate it if it is ever exposed.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SECRET_KEY

# OpenRouter (server-side Edge Function secret only).
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini
